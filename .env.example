# ── 공공데이터포털(data.go.kr) 인증키 ───────────────────────────────
# 아래 두 서비스를 "활용신청"하면 계정당 하나의 인증키로 모두 사용됩니다.
#   1) 청약홈 분양정보 조회 서비스   https://www.data.go.kr/data/15098547/openapi.do
#   2) 청약홈 경쟁률 조회 서비스     https://www.data.go.kr/data/15098905/openapi.do  (경쟁률 표시용)
# Decoding(일반) 키를 그대로 넣으면 됩니다. (앱 내부에서 인코딩 처리)
# 키가 없으면 앱은 샘플 데이터로 동작합니다.
APPLYHOME_SERVICE_KEY=

# ── 카카오 지도 (선택) ──────────────────────────────────────────────
# https://developers.kakao.com 에서 앱 생성 → JavaScript 키.
# Web 플랫폼에 배포 도메인과 http://localhost:3000 을 등록해야 지도가 뜹니다.
# 없으면 상세페이지 지도는 "카카오맵에서 보기" 링크로 대체됩니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── 웹 푸시 알림 (선택, 앱 꺼져도 알림) ──────────────────────────────
# VAPID 키: `npx web-push generate-vapid-keys` 로 생성.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 매일 발송 크론 보호용 임의 문자열 (Vercel Cron이 이 값을 Bearer로 보냄)
CRON_SECRET=
# 구독 저장소 (Upstash Redis 또는 Vercel KV). 둘 중 하나 세트만 있으면 됨.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
